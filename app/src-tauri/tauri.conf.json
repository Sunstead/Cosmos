{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmos",
  "version": "../package.json",
  "identifier": "net.sunstead.cosmos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFOUI5OTM3RTAzMzc1QzgKUldUSWRUUGdONW1iL3NCeFRiK2dqUXpWcFRUK1ZRODVTeHhwZFZnYWdac0Q3bERyQXc4bkRJQmYK",
      "endpoints": ["https://github.com/Sunstead/Cosmos/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      },
      "signingIdentity": "-"
    }
  }
}
